    {
      "_id": "34a5265b68649e9c",
      "name": "Condições",
      "type": "text",
      "sort": 300000,
      "title": {
        "show": false,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<div class=\"nexus-wiki\" style=\"color:#FFFFFF;font-size:17px\"><p style=\"text-align:center;white-space:pre-wrap\"><span style=\"color:#FFFFFF;font-size:36px\"><strong>  C O N D I Ç Õ E S</strong></span></p><p style=\"text-align:center;white-space:pre-wrap\"><span style=\"color:#FFFFFF;font-size:20px\"><strong></strong></span></p><p style=\"text-align:center;white-space:pre-wrap\"><img src=\"systems/nexus-jjk/assets/journal/tabela-condicoes.png\" class=\"tabela-img\" style=\"max-width:100%;height:auto;width:564.799987792969px\" alt=\"\"></p><p style=\"text-align:center;white-space:pre-wrap\"><span style=\"color:#FFFFFF;font-size:17px\">____________________________________________________________________________________</span></p><p style=\"text-align:center;white-space:pre-wrap\"><span style=\"color:#FFFFFF;font-size:17px\"></span></p><p style=\"text-align:center;white-space:pre-wrap\"><span style=\"color:#FFFFFF;font-size:17px\">   </span><span style=\"color:#FFFFFF;font-size:17px\"><strong>Condição </strong></span><span style=\"color:#FFFFFF;font-size:17px\"><strong><em>Derrubado</em></strong></span><span style=\"color:#FFFFFF;font-size:17px\"><strong>:</strong></span><span style=\"color:#FFFFFF;font-size:17px\"> O personagem está caído. Enquanto permanecer neste estado, recebem </span><span style=\"color:#FFFFFF;font-size:17px\"><strong>desvantagem em testes físicos</strong></span><span style=\"color:#FFFFFF;font-size:17px\">.</span></p><p style=\"text-align:center;white-space:pre-wrap\"><span style=\"color:#FFFFFF;font-size:17px\">Além disso, </span><span style=\"color:#FFFFFF;font-size:17px\"><strong>ataques corpo a corpo</strong></span><span style=\"color:#FFFFFF;font-size:17px\"> contra o personagem recebem </span><span style=\"color:#FFFFFF;font-size:17px\"><strong>Vantagem</strong></span><span style=\"color:#FFFFFF;font-size:17px\">, enquanto </span><span style=\"color:#FFFFFF;font-size:17px\"><strong>ataques à distância</strong></span><span style=\"color:#FFFFFF;font-size:17px\"> recebem </span><span style=\"color:#FFFFFF;font-size:17px\"><strong>desvantagem</strong></span><span style=\"color:#FFFFFF;font-size:17px\">.</span></p><p style=\"text-align:center;white-space:pre-wrap\"><span style=\"color:#FFFFFF;font-size:17px\">O personagem pode se levantar utilizando uma</span><span style=\"color:#FFFFFF;font-size:17px\"><strong> Ação de Movimento</strong></span><span style=\"color:#FFFFFF;font-size:17px\">, encerrando esta condição.</span></p><p style=\"text-align:center;white-space:pre-wrap\"><span style=\"color:#FFFFFF;font-size:17px\"></span></p><p style=\"text-align:center;white-space:pre-wrap\"><span style=\"color:#FFFFFF;font-size:17px\"></span></p><p style=\"text-align:center;white-space:pre-wrap\"><span style=\"color:#FFFFFF;font-size:17px\"></span></p><p style=\"text-align:center;white-space:pre-wrap\"><span style=\"color:#FFFFFF;font-size:17px\">____________________________________________________________________________________</span></p></div>"
      },
