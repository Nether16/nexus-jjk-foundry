      "text": {
        "format": 1,
        "content": "<div class=\"nexus-wiki nexus-catalogo\"> \n <!-- CLÃ ZEN'IN --> \n <img src=\"systems/nexus-jjk/assets/journal/cla-zenin-banner.png\" alt=\"Clã Zen'in\" style=\"max-width: 240px; margin: 16px auto;\"> \n\n <div class=\"nexus-catalogo-grid\" style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; text-align: center; margin-top: 12px;\"> \n   <div class=\"nexus-catalogo-espaco\"></div> \n   <div class=\"nexus-catalogo-destaque\" style=\"grid-column: span 2;\"> \n     <p style=\"margin-bottom: 6px;\"><strong>Dez Sombras</strong></p> \n     <img src=\"systems/nexus-jjk/assets/journal/catalogo-dez-sombras.gif\" alt=\"Dez Sombras\" style=\"max-width: 220px; width: 100%; border-radius: 4px; margin: 0 auto;\"> \n     <p style=\"margin-top: 6px;\"><strong>Vaga 1/1 - R$ 55</strong></p> \n   </div> \n   <div class=\"nexus-catalogo-espaco\"></div> \n\n   <div> \n     <p style=\"margin-bottom: 6px;\"><strong>Projeção</strong></p> \n     <img src=\"systems/nexus-jjk/assets/journal/catalogo-projecao.gif\" alt=\"Projeção\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n     <p style=\"margin-top: 6px;\"><strong>Vaga 1/1 - R$ 50</strong></p> \n   </div> \n\n   <div> \n     <p style=\"margin-bottom: 6px;\"><strong>Eart Manipulation</strong></p> \n     <img src=\"systems/nexus-jjk/assets/journal/catalogo-earth-manipulation.gif\" alt=\"Eart Manipulation\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n     <p style=\"margin-top: 6px;\"><strong>Vaga 0/1 - R$ 50</strong></p> \n   </div> \n </div> \n\n <hr style=\"width: 25%; margin: 28px auto;\"> \n\n <!-- CLÃ KAMO --> \n <img src=\"systems/nexus-jjk/assets/journal/cla-kamo-banner.png\" alt=\"Clã Kamo\" style=\"max-width: 240px; margin: 16px auto;\"> \n\n <div style=\"max-width: 220px; margin: 12px auto; text-align: center;\"> \n   <p style=\"margin-bottom: 6px;\"><strong>Manipulação de Sangue</strong></p> \n   <img src=\"systems/nexus-jjk/assets/journal/catalogo-manipulacao-sangue.gif\" alt=\"Manipulação de Sangue\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n   <p style=\"margin-top: 6px;\"><strong>Vaga 0/1 - R$ 50</strong></p> \n </div> \n\n <hr style=\"width: 25%; margin: 28px auto;\"> \n\n <!-- CLÃ INUMAKI --> \n <img src=\"systems/nexus-jjk/assets/journal/cla-inumaki-banner.png\" alt=\"Clã Inumaki\" style=\"max-width: 240px; margin: 16px auto;\"> \n\n <div style=\"max-width: 220px; margin: 12px auto; text-align: center;\"> \n   <p style=\"margin-bottom: 6px;\"><strong>Fala Amaldiçoada</strong></p> \n   <img src=\"systems/nexus-jjk/assets/journal/catalogo-fala-amaldicoada.gif\" alt=\"Fala Amaldiçoada\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n   <p style=\"margin-top: 6px;\"><strong>Vaga 0/1 - R$ 50</strong></p> \n </div> \n\n <hr style=\"width: 25%; margin: 28px auto;\"> \n\n <!-- CLÃ FUJIWARA --> \n <img src=\"systems/nexus-jjk/assets/journal/cla-fujiwara-banner.png\" alt=\"Clã Fujiwara\" style=\"max-width: 240px; margin: 16px auto;\"> \n\n <div style=\"max-width: 220px; margin: 12px auto; text-align: center;\"> \n   <p style=\"margin-bottom: 6px;\"><strong>Sky Manipulation</strong></p> \n   <img src=\"systems/nexus-jjk/assets/journal/catalogo-sky-manipulation.gif\" alt=\"Sky Manipulation\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n   <p style=\"margin-top: 6px;\"><strong>Vaga 1/1 - R$ 50</strong></p> \n </div> \n</div>"
