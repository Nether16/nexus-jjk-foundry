      "text": {
        "format": 1,
        "content": "<div class=\"nexus-wiki nexus-catalogo\"> \n <div class=\"nexus-catalogo-grid\" style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; text-align: center; margin-top: 12px;\"> \n   <div> \n     <p style=\"margin-bottom: 6px;\"><strong>Disaster Tides</strong></p> \n     <img src=\"systems/nexus-jjk/assets/journal/catalogo-disaster-tides.gif\" alt=\"Disaster Tides\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n     <p style=\"margin-top: 6px;\"><strong>Vaga 0/1 - R$ 50</strong></p> \n   </div> \n\n   <div> \n     <p style=\"margin-bottom: 6px;\"><strong>Disaster Plants</strong></p> \n     <img src=\"systems/nexus-jjk/assets/journal/catalogo-disaster-plants.gif\" alt=\"Disaster Plants\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n     <p style=\"margin-top: 6px;\"><strong>Vaga 1/1 - R$ 50</strong></p> \n   </div> \n\n   <div> \n     <p style=\"margin-bottom: 6px;\"><strong>Boogie Woogie</strong></p> \n     <img src=\"systems/nexus-jjk/assets/journal/catalogo-boogie-woogie.gif\" alt=\"Boogie Woogie\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n     <p style=\"margin-top: 6px;\"><strong>Vaga 0/1 - R$ 50</strong></p> \n   </div> \n\n   <div> \n     <p style=\"margin-bottom: 6px;\"><strong>Ice Formation</strong></p> \n     <img src=\"systems/nexus-jjk/assets/journal/catalogo-ice-formation.gif\" alt=\"Ice Formation\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n     <p style=\"margin-top: 6px;\"><strong>Vaga 0/1 - R$ 50</strong></p> \n   </div> \n\n   <div> \n     <p style=\"margin-bottom: 6px;\"><strong>Granite Blast</strong></p> \n     <img src=\"systems/nexus-jjk/assets/journal/catalogo-granite-blast.gif\" alt=\"Granite Blast\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n     <p style=\"margin-top: 6px;\"><strong>Vaga 0/1 - R$ 50</strong></p> \n   </div> \n\n   <div> \n     <p style=\"margin-bottom: 6px;\"><strong>Anti-Gravity Sistem</strong></p> \n     <img src=\"systems/nexus-jjk/assets/journal/catalogo-anti-gravity-sistem.gif\" alt=\"Anti-Gravity Sistem\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n     <p style=\"margin-top: 6px;\"><strong>Vaga 1/1 - R$ 50</strong></p> \n   </div> \n\n   <div> \n     <p style=\"margin-bottom: 6px;\"><strong>Star Rage</strong></p> \n     <img src=\"systems/nexus-jjk/assets/journal/catalogo-star-rage.gif\" alt=\"Star Rage\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n     <p style=\"margin-top: 6px;\"><strong>Vaga 1/1 - R$ 50</strong></p> \n   </div> \n\n   <div> \n     <p style=\"margin-bottom: 6px;\"><strong>7:3</strong></p> \n     <img src=\"systems/nexus-jjk/assets/journal/catalogo-7-3.gif\" alt=\"7:3\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n     <p style=\"margin-top: 6px;\"><strong>Vaga 1/1 - R$ 50</strong></p> \n   </div> \n\n   <div> \n     <p style=\"margin-bottom: 6px;\"><strong>Orbital Domain</strong></p> \n     <img src=\"systems/nexus-jjk/assets/journal/catalogo-orbital-domain.gif\" alt=\"Orbital Domain\" style=\"width: 100%; border-radius: 4px; margin: 0;\"> \n     <p style=\"margin-top: 6px;\"><strong>Vaga 0/1 - R$ 50</strong></p> \n   </div> \n </div> \n</div>"
